```powershell
# ============================================================
# MATRICE CROISÉE : Utilisateurs x Groupes DFS (via Fonctionnels)
# ============================================================

$GroupesDFS = Get-ADGroup -Filter {Name -like "GG_BDX_BNU_CDAD*"} -Properties Members | Sort-Object Name
$GroupesFonctionnels = Get-ADGroup -Filter {Name -like "GG_F_CDAD-BDX*"} -Properties Members | Sort-Object Name

$relationsDFS = @{}
foreach ($dfs in $GroupesDFS) {
    $membres = Get-ADGroupMember -Identity $dfs.Name | Where-Object {$_.ObjectClass -eq "group" -and $_.Name -like "GG_F_CDAD-BDX*"}
    $relationsDFS[$dfs.Name] = $membres | Select-Object -ExpandProperty Name
}

$relationsFont = @{}
foreach ($f in $GroupesFonctionnels) {
    $membres = Get-ADGroupMember -Identity $f.Name -Recursive | Where-Object {$_.ObjectClass -eq "user"}
    $relationsFont[$f.Name] = $membres | Select-Object -ExpandProperty SamAccountName
}

$tousLesUsers = @{}
foreach ($f in $GroupesFonctionnels) {
    if ($relationsFont[$f.Name]) {
        foreach ($u in $relationsFont[$f.Name]) { $tousLesUsers[$u] = $true }
    }
}
$usersList    = $tousLesUsers.Keys | Sort-Object
$dfsList      = $GroupesDFS.Name
$fonctionnels = $GroupesFonctionnels.Name

# ============================================================
# COLONNES DFS ACTIVES
# ============================================================
$dfsActifs = @()
foreach ($dfs in $dfsList) {
    $aUnDroit = $false
    foreach ($user in $usersList) {
        foreach ($f in $relationsDFS[$dfs]) {
            if ($relationsFont[$f] -contains $user) { $aUnDroit = $true; break }
        }
        if ($aUnDroit) { break }
    }
    if ($aUnDroit) { $dfsActifs += $dfs }
}

# ============================================================
# COULEURS PAR GROUPE (basé sur ce qui suit CDAD dans le nom)
# ============================================================
function Get-GroupeKey {
    param($nom, $prefixeASupprimer)
    $court = $nom -replace $prefixeASupprimer, ""
    # Extraire le premier segment après le préfixe (avant le prochain - ou _)
    if ($court -match "^[-_]?([^-_]+)") { return $Matches[1] }
    return $court
}

# Palette de couleurs modernes par groupe - séries distinctes
$palettesGroupes = @(
    # Série Bleu
    @{ entete = [long](  30*65536 + 100*256 + 180); alt1 = [long]( 210*65536 + 228*256 + 245); alt2 = [long]( 235*65536 + 244*256 + 252) },
    # Série Vert
    @{ entete = [long](  60*65536 + 140*256 +  80); alt1 = [long]( 210*65536 + 235*256 + 210); alt2 = [long]( 235*65536 + 248*256 + 235) },
    # Série Orange
    @{ entete = [long]( 200*65536 + 100*256 +  30); alt1 = [long]( 250*65536 + 225*256 + 195); alt2 = [long]( 253*65536 + 242*256 + 228) },
    # Série Violet
    @{ entete = [long]( 110*65536 +  60*256 + 160); alt1 = [long]( 225*65536 + 210*256 + 240); alt2 = [long]( 242*65536 + 232*256 + 250) },
    # Série Rose
    @{ entete = [long]( 190*65536 +  60*256 + 100); alt1 = [long]( 245*65536 + 210*256 + 220); alt2 = [long]( 252*65536 + 235*256 + 240) },
    # Série Cyan
    @{ entete = [long](  20*65536 + 140*256 + 160); alt1 = [long]( 200*65536 + 235*256 + 240); alt2 = [long]( 228*65536 + 246*256 + 248) },
    # Série Bordeaux
    @{ entete = [long]( 150*65536 +  30*256 +  60); alt1 = [long]( 240*65536 + 200*256 + 210); alt2 = [long]( 250*65536 + 228*256 + 232) },
    # Série Kaki
    @{ entete = [long]( 100*65536 + 120*256 +  40); alt1 = [long]( 220*65536 + 232*256 + 195); alt2 = [long]( 238*65536 + 245*256 + 220) }
)

function Get-CouleurGroupes {
    param($liste, $prefixeRegex)
    $groupeIndex = @{}
    $idx = 0
    $map = @{}
    foreach ($nom in $liste) {
        $key = Get-GroupeKey -nom $nom -prefixeASupprimer $prefixeRegex
        if (-not $groupeIndex.ContainsKey($key)) {
            $groupeIndex[$key] = $idx
            $idx++
        }
        $map[$nom] = $groupeIndex[$key]
    }
    return $map
}

$mapCouleurDFS  = Get-CouleurGroupes -liste $dfsActifs   -prefixeRegex "^GG_BDX_BNU_CDAD[-_]?"
$mapCouleurFont = Get-CouleurGroupes -liste $fonctionnels -prefixeRegex "^GG_F_CDAD-BDX[-_]?"
$mapCouleurDFSAll = Get-CouleurGroupes -liste $dfsList    -prefixeRegex "^GG_BDX_BNU_CDAD[-_]?"

# Couleurs fixes
$blanc       = [long](255*65536 + 255*256 + 255)
$noir        = [long](  0*65536 +   0*256 +   0)
$grisEntete  = [long]( 40*65536 +  40*256 +  40)
$grisLigne1  = [long](235*65536 + 235*256 + 235)
$grisLigne2  = [long](255*65536 + 255*256 + 255)
$couleurRW   = [long]( 90*65536 +  90*256 +  90)   # Gris foncé pour RW
$couleurR    = [long](170*65536 + 170*256 + 170)   # Gris clair pour R

# ============================================================
# FONCTION BORDURES NOIRES FINES
# ============================================================
function Set-Borders {
    param($range)
    foreach ($edge in @(7,8,9,10,11,12)) {
        $range.Borders.Item($edge).LineStyle = 1
        $range.Borders.Item($edge).Weight    = 2
        $range.Borders.Item($edge).Color     = $noir
    }
}

