function Get-ExcelColor($r, $g, $b) {
    return $r + ($g * 256) + ($b * 65536)
}

$palette = @(
    (Get-ExcelColor 183  222  232),
    (Get-ExcelColor 216  228  188),
    (Get-ExcelColor 252 213   180),
    (Get-ExcelColor 230  184  183),
    (Get-ExcelColor 204  192  218)
)

# ============================================================
# LECTURE DU FICHIER EXCEL DES ACTIFS
# ============================================================
# Le fichier doit contenir une colonne "SamAccountName" ou "Login"
$fichierActifs = "C:\Users\x\Downloads\actifs.xlsx"

$excelLecture = New-Object -ComObject Excel.Application
$excelLecture.Visible = $false
$wbActifs = $excelLecture.Workbooks.Open($fichierActifs)
$wsActifs = $wbActifs.Worksheets.Item(1)

# Lecture de la colonne A (SamAccountName des actifs)
$ligneMax = $wsActifs.UsedRange.Rows.Count
$listeActifs = @()
for ($i = 2; $i -le $ligneMax; $i++) {  # i=2 pour sauter l'en-tête
    $val = $wsActifs.Cells.Item($i, 1).Value2
    if ($val) { $listeActifs += $val.Trim().ToLower() }
}

$wbActifs.Close($false)
$excelLecture.Quit()
[System.Runtime.InteropServices.Marshal]::ReleaseComObject($excelLecture) | Out-Null

Write-Host "Actifs chargés : $($listeActifs.Count) personnes" -ForegroundColor Cyan

# ============================================================
# RÉCUPÉRATION AD
# ============================================================
$groupes = Get-ADGroup -Filter {Name -like "GG_F_CDAD-BDX*"} | Sort-Object Name

$utilisateurs = $groupes | ForEach-Object {
    Get-ADGroupMember -Identity $_ -Recursive | Where-Object { $_.objectClass -eq "user" }
} | Sort-Object SamAccountName | Select-Object -Unique -Property Name, SamAccountName

# Construction de la matrice
$matrice = foreach ($user in $utilisateurs) {
    $userAD = Get-ADUser $user.SamAccountName -Properties MemberOf, DisplayName
    $groupesUser = $userAD.MemberOf | ForEach-Object { (Get-ADGroup $_).Name }
    $ligne = [ordered]@{ "Utilisateur" = $userAD.SamAccountName }
    foreach ($groupe in $groupes) {
        $ligne[$groupe.Name] = if ($groupesUser -contains $groupe.Name) { "+" } else { "" }
    }
    [PSCustomObject]$ligne
}

# ============================================================
# CROISEMENT : qui est dans AD mais PAS dans les actifs ?
# qui est dans les actifs mais PAS dans AD ?
# ============================================================
$samsAD      = $matrice | ForEach-Object { $_.Utilisateur.ToLower() }

# Dans AD mais absent des actifs => à supprimer
$aSupprimer  = $matrice | Where-Object { $listeActifs -notcontains $_.Utilisateur.ToLower() }

# Dans les actifs mais absent de l'AD => à ajouter
$aAjouter    = $listeActifs | Where-Object { $samsAD -notcontains $_ }

Write-Host "À supprimer des groupes : $($aSupprimer.Count)" -ForegroundColor Red
Write-Host "À ajouter dans les groupes : $($aAjouter.Count)" -ForegroundColor Yellow

# ============================================================
# EXCEL - ÉCRITURE
# ============================================================
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$wb = $excel.Workbooks.Add()

# ========================
# ONGLET 1 - MATRICE PRINCIPALE
# ========================
$ws = $wb.Worksheets.Item(1)
$ws.Name = "Matrice Droits"

$colonnes = $matrice[0].PSObject.Properties.Name

# En-tête
for ($col = 0; $col -lt $colonnes.Count; $col++) {
    $cell = $ws.Cells.Item(1, $col + 1)
    $cell.Value2 = $colonnes[$col]
    $cell.Font.Bold = $true
    $cell.Font.Size = 7

    if ($col -eq 0) {
        $cell.Interior.Color = Get-ExcelColor 255 255 255
        $cell.Font.Color = 0x000000
        $cell.VerticalAlignment = -4107
    } else {
        $cell.Interior.Color = $palette[($col - 1) % 5]
        $cell.Font.Color = 0x000000
        $cell.Orientation = 90
        $cell.VerticalAlignment = -4107
        $cell.HorizontalAlignment = -4108
    }
}
$ws.Rows.Item(1).RowHeight = 100

# Données
for ($lig = 0; $lig -lt $matrice.Count; $lig++) {
    $ligne = $matrice[$lig]
    $excelLig = $lig + 2
    $estASupprimer = $listeActifs -notcontains $ligne.Utilisateur.ToLower()

    for ($col = 0; $col -lt $colonnes.Count; $col++) {
        $cell = $ws.Cells.Item($excelLig, $col + 1)
        $valeur = $ligne.($colonnes[$col])
        $cell.Value2 = $valeur
        $cell.Font.Size = 7

        foreach ($edge in @(7, 8, 9, 10)) {
            $cell.Borders.Item($edge).LineStyle = 1
            $cell.Borders.Item($edge).Weight = 2
            $cell.Borders.Item($edge).Color = 0x000000
        }

        if ($col -eq 0) {
            # Colonne nom : rouge si à supprimer, sinon alternance gris
            if ($estASupprimer) {
                $cell.Interior.Color = Get-ExcelColor 255 180 180
            } elseif ($excelLig % 2 -eq 0) {
                $cell.Interior.Color = Get-ExcelColor 200 200 200
            } else {
                $cell.Interior.Color = Get-ExcelColor 235 235 235
            }
        } elseif ($valeur -eq "+") {
            if ($estASupprimer) {
                $cell.Interior.Color = Get-ExcelColor 200 80 80   # Rouge foncé si à supprimer
            } else {
                $cell.Interior.Color = Get-ExcelColor 80 80 80
            }
            $cell.Font.Color = 0xFFFFFF
            $cell.HorizontalAlignment = -4108
            $cell.Font.Bold = $true
        } else {
            if ($estASupprimer) {
                $cell.Interior.Color = Get-ExcelColor 255 200 200
            } elseif ($excelLig % 2 -eq 0) {
                $cell.Interior.Color = Get-ExcelColor 200 200 200
            } else {
                $cell.Interior.Color = Get-ExcelColor 235 235 235
            }
        }
    }
    $ws.Rows.Item($excelLig).RowHeight = 11
}

# Figer volets + largeurs
$ws.Cells.Item(2, 2).Select()
$excel.ActiveWindow.FreezePanes = $true
$ws.Columns.Item(1).ColumnWidth = 15
for ($col = 2; $col -le $colonnes.Count; $col++) {
    $ws.Columns.Item($col).ColumnWidth = 2.5
}

# ========================
# ONGLET 2 - À SUPPRIMER
# ========================
$wb.Worksheets.Add() | Out-Null
$ws2 = $wb.Worksheets.Item(2)
$ws2.Name = "A Supprimer"

# En-tête onglet 2
$ws2.Cells.Item(1,1).Value2 = "SamAccountName"
$ws2.Cells.Item(1,2).Value2 = "Raison"
$ws2.Cells.Item(1,1).Font.Bold = $true
$ws2.Cells.Item(1,2).Font.Bold = $true
$ws2.Cells.Item(1,1).Interior.Color = Get-ExcelColor 192 0 0
$ws2.Cells.Item(1,2).Interior.Color = Get-ExcelColor 192 0 0
$ws2.Cells.Item(1,1).Font.Color = 0xFFFFFF
$ws2.Cells.Item(1,2).Font.Color = 0xFFFFFF

$row2 = 2
foreach ($u in $aSupprimer) {
    $ws2.Cells.Item($row2, 1).Value2 = $u.Utilisateur
    $ws2.Cells.Item($row2, 2).Value2 = "Présent dans AD/groupes mais absent de la liste des actifs"
    $ws2.Cells.Item($row2, 1).Interior.Color = Get-ExcelColor 255 210 210
    $ws2.Cells.Item($row2, 2).Interior.Color = Get-ExcelColor 255 230 230
    foreach ($col in @(1,2)) {
        foreach ($edge in @(7,8,9,10)) {
            $ws2.Cells.Item($row2,$col).Borders.Item($edge).LineStyle = 1
            $ws2.Cells.Item($row2,$col).Borders.Item($edge).Weight = 2
            $ws2.Cells.Item($row2,$col).Borders.Item($edge).Color = 0x000000
        }
    }
    $ws2.Rows.Item($row2).RowHeight = 11
    $row2++
}
$ws2.Columns.Item(1).ColumnWidth = 25
$ws2.Columns.Item(2).ColumnWidth = 55

# ========================
# ONGLET 3 - À AJOUTER
# ========================
$wb.Worksheets.Add() | Out-Null
$ws3 = $wb.Worksheets.Item(3)
$ws3.Name = "A Ajouter"

$ws3.Cells.Item(1,1).Value2 = "SamAccountName"
$ws3.Cells.Item(1,2).Value2 = "Raison"
$ws3.Cells.Item(1,1).Font.Bold = $true
$ws3.Cells.Item(1,2).Font.Bold = $true
$ws3.Cells.Item(1,1).Interior.Color = Get-ExcelColor 0 112 0
$ws3.Cells.Item(1,2).Interior.Color = Get-ExcelColor 0 112 0
$ws3.Cells.Item(1,1).Font.Color = 0xFFFFFF
$ws3.Cells.Item(1,2).Font.Color = 0xFFFFFF

$row3 = 2
foreach ($sam in $aAjouter) {
    $ws3.Cells.Item($row3, 1).Value2 = $sam
    $ws3.Cells.Item($row3, 2).Value2 = "Présent dans la liste des actifs mais absent des groupes AD"
    $ws3.Cells.Item($row3, 1).Interior.Color = Get-ExcelColor 210 255 210
    $ws3.Cells.Item($row3, 2).Interior.Color = Get-ExcelColor 230 255 230
    foreach ($col in @(1,2)) {
        foreach ($edge in @(7,8,9,10)) {
            $ws3.Cells.Item($row3,$col).Borders.Item($edge).LineStyle = 1
            $ws3.Cells.Item($row3,$col).Borders.Item($edge).Weight = 2
            $ws3.Cells.Item($row3,$col).Borders.Item($edge).Color = 0x000000
        }
    }
    $ws3.Rows.Item($row3).RowHeight = 11
    $row3++
}
$ws3.Columns.Item(1).ColumnWidth = 25
$ws3.Columns.Item(2).ColumnWidth = 55

# ============================================================
# SAUVEGARDE
# ============================================================
$fichier = "C:\Users\x\Downloads\matrice_droits.xlsx"
$wb.SaveAs($fichier)
$wb.Close()
$excel.Quit()
[System.Runtime.InteropServices.Marshal]::ReleaseComObject($excel) | Out-Null

Write-Host "Export terminé : $fichier" -ForegroundColor Green
Write-Host "  → Onglet 'Matrice Droits' : vue complète (lignes rouges = à supprimer)" -ForegroundColor White
Write-Host "  → Onglet 'A Supprimer'    : $($aSupprimer.Count) comptes en trop" -ForegroundColor Red
Write-Host "  → Onglet 'A Ajouter'      : $($aAjouter.Count) comptes