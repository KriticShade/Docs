## Bonus : Onglet inversé (Groupes → Membres)

```powershell
# Ajouter un 2ème onglet : vue par groupe

$VueGroupes = foreach ($Groupe in $Groupes) {
    
    $Membres = Get-ADGroupMember -Identity $Groupe -Recursive | 
        Where-Object { $_.objectClass -eq "user" } |
        ForEach-Object { $_.SamAccountName }
    
    [PSCustomObject]@{
        "Groupe"       = $Groupe.Name
        "Description"  = $Groupe.Description
        "NbMembres"    = $Membres.Count
        "Membres"      = ($Membres -join ", ")
    }
}

# Ajout dans le même fichier Excel
$VueGroupes | Export-Excel -Path $OutputPath `
    -WorksheetName "Vue par Groupe" `
    -AutoSize -AutoFilter -BoldTopRow `
    -TableName "VueGroupes" -TableStyle "Medium4"
```

