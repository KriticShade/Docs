function Write-UserRow {
    param($ws, $row, $sam, $groupes, $couleurFond, $couleurX)

    $ws.Cells.Item($row, 1).Value2 = $sam
    $ws.Cells.Item($row, 1).Interior.Color = $couleurFond
    $ws.Cells.Item($row, 1).Font.Bold = $false
    $ws.Rows.Item($row).RowHeight = 11

    foreach ($edge in @(7,8,9,10)) {
        $ws.Cells.Item($row,1).Borders.Item($edge).LineStyle = 1
        $ws.Cells.Item($row,1).Borders.Item($edge).Weight = 2
        $ws.Cells.Item($row,1).Borders.Item($edge).Color = 0x000000
    }

    $colIdx = 2
    $colorIdx = 0
    foreach ($groupe in $groupes) {
        try {
            $membres = Get-ADGroupMember -Identity $groupe -Recursive |
                       Where-Object { $_.objectClass -eq "user" } |
                       ForEach-Object { $_.SamAccountName.ToLower() }
            $estMembre = $membres -contains $sam.ToLower()
        } catch { $estMembre = $false }

        $cell = $ws.Cells.Item($row, $colIdx)
        if ($estMembre) {
            $cell.Value2 = "+"
            $cell.Font.Bold = $true
            $cell.Interior.Color = $couleurX
        } else {
            $cell.Interior.Color = $palette[$colorIdx % $palette.Count]
        }
        foreach ($edge in @(7,8,9,10)) {
            $cell.Borders.Item($edge).LineStyle = 1
            $cell.Borders.Item($edge).Weight = 2
            $cell.Borders.Item($edge).Color = 0x000000
        }
        $colIdx++
        $colorIdx++
    }
}

