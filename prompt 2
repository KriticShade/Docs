Dans la feuille droits utilisateurs tu vas indiquer jusqu'à niveau de l'architecture, le premier niveau début avec le tiret à la suite de CDAD et à chaque niveau ça donne un niveau. Comme ça tu étale les noms sur les différentes cellules donc 4. le début du le met sur le premier niveau. Ensuite toutes les cellules sont en nuances de bleues. Et toutes les lignes sont en noir fin mais que tu vois les démarquations. Puis pour les groupes global dfs s'il n'y a rien dans la collonne tu ne le mets pas. Par contre pour les utilisateurs à gauche tu ne changes pas hormis le style trait tableau


# ============================================================
# MATRICE CROISÉE : Utilisateurs x Groupes DFS avec niveaux
# ============================================================

$GroupesDFS = Get-ADGroup -Filter {Name -like "GG_BDX_BNU_CDAD*"} -Properties Members | Sort-Object Name
$GroupesFonctionnels = Get-ADGroup -Filter {Name -like "GG_F_CDAD-BDX*"} -Properties Members | Sort-Object Name

$relationsDFS = @{}
foreach ($dfs in $GroupesDFS) {
    $membres = Get-ADGroupMember -Identity $dfs.Name | Where-Object {$_.ObjectClass -eq "group" -and $_.Name -like "GG_F_CDAD-BDX*"}
    $relationsDFS[$dfs.Name] = $membres | Select-Object -ExpandProperty Name
}

$relationsFont = @{}
foreach ($f in $GroupesFonctionnels) {
    $membres = Get-ADGroupMember -Identity $f.Name -Recursive | Where-Object {$_.ObjectClass -eq "user"}
    $relationsFont[$f.Name] = $membres | Select-Object -ExpandProperty SamAccountName
}

$tousLesUsers = @{}
foreach ($f in $GroupesFonctionnels) {
    if ($relationsFont[$f.Name]) {
        foreach ($u in $relationsFont[$f.Name]) {
            $tousLesUsers[$u] = $true
        }
    }
}
$usersList = $tousLesUsers.Keys | Sort-Object
$fonctionnels = $GroupesFonctionnels.Name

# ============================================================
# FILTRER DFS : garder seulement ceux qui ont au moins 1 user
# ============================================================
$dfsFiltres = @()
foreach ($dfs in $GroupesDFS) {
    $aUnUser = $false
    foreach ($f in $relationsDFS[$dfs.Name]) {
        foreach ($u in $usersList) {
            if ($relationsFont[$f] -contains $u) {
                $aUnUser = $true
                break
            }
        }
        if ($aUnUser) { break }
    }
    if ($aUnUser) { $dfsFiltres += $dfs.Name }
}

# ============================================================
# DÉCOMPOSER NOM DFS EN NIVEAUX
# Exemple : GG_BDX_BNU_CDAD-NIV1-NIV2-NIV3-RW
# On prend la partie après "CDAD-"
# ============================================================
function Get-NiveauxDFS {
    param($nomDFS)
    $partie = $nomDFS -replace "^GG_BDX_BNU_CDAD-", ""
    $parts  = $partie -split "-"
    # On retourne un tableau de 4 éléments (padding avec "")
    $result = @("","","","")
    for ($i = 0; $i -lt [Math]::Min($parts.Count, 4); $i++) {
        $result[$i] = $parts[$i]
    }
    return $result
}

# ============================================================
# COULEURS
# ============================================================
# Nuances de bleu pour les en-têtes niveaux
$bleusNiveaux = @(
    [long](31  * 65536 + 73  * 256 + 125),  # Bleu très foncé  - Niveau 1
    [long](17  * 65536 + 125 * 256 + 187),  # Bleu foncé       - Niveau 2
    [long](83  * 65536 + 166 * 256 + 208),  # Bleu moyen       - Niveau 3
    [long](189 * 65536 + 215 * 256 + 238)   # Bleu clair       - Niveau 4
)
$blanc      = [long](255 * 65536 + 255 * 256 + 255)
$grisEntete = [long](64  * 65536 + 64  * 256 + 64)
$couleurRW  = [long](31  * 65536 + 73  * 256 + 125)  # Bleu foncé
$couleurR   = [long](83  * 65536 + 166 * 256 + 208)  # Bleu moyen
$noir       = [long](0   * 65536 + 0   * 256 + 0)

# ============================================================
# CRÉATION EXCEL
# ============================================================
$Excel = New-Object -ComObject Excel.Application
$Excel.Visible = $false
$Workbook = $Excel.Workbooks.Add()

while ($Workbook.Sheets.Count -gt 1) {
    $Workbook.Sheets.Item($Workbook.Sheets.Count).Delete()
}

# ============================================================
# FEUILLE 1 : Droits Utilisateurs
# ============================================================
$Sheet1 = $Workbook.Sheets.Item(1)
$Sheet1.Name = "Droits Utilisateurs"

# Lignes 1 à 4 = niveaux architecture DFS
# Colonne 1 = étiquette niveau
# Colonnes 2+ = valeurs pour chaque DFS filtré

# Cellules A1 à A4 : labels niveaux
for ($niv = 1; $niv -le 4; $niv++) {
    $cell = $Sheet1.Cells.Item($niv, 1)
    $cell.Value2 = "Niveau $niv"
    $cell.Font.Bold = $true
    $cell.Font.Size = 10
    $cell.Font.Color = $blanc
    $cell.Interior.Color = $bleusNiveaux[$niv - 1]
    $cell.HorizontalAlignment = -4108
}

# Remplir les 4 lignes de niveaux pour chaque DFS
$col = 2
foreach ($dfs in $dfsFiltres) {
    $niveaux = Get-NiveauxDFS -nomDFS $dfs
    for ($niv = 0; $niv -le 3; $niv++) {
        $cell = $Sheet1.Cells.Item($niv + 1, $col)
        $cell.Value2 = $niveaux[$niv]
        $cell.Font.Bold = $true
        $cell.Font.Size = 10
        $cell.Font.Color = $blanc
        $cell.Interior.Color = $bleusNiveaux[$niv]
        $cell.Orientation = 90
        $cell.HorizontalAlignment = -4108
        $cell.VerticalAlignment   = -4107
    }
    $col++
}

# Fusionner A1:A4 pour le label "Utilisateur"
# En fait on met "Utilisateur" dans une cellule fusionnée A1:A4
$rangeFusion = $Sheet1.Range($Sheet1.Cells.Item(1,1), $Sheet1.Cells.Item(4,1))
$rangeFusion.Merge()
$rangeFusion.Value2 = "Utilisateur \ DFS"
$rangeFusion.Font.Bold = $true
$rangeFusion.Font.Size = 10
$rangeFusion.Font.Color = $blanc
$rangeFusion.Interior.Color = $grisEntete
$rangeFusion.HorizontalAlignment = -4108
$rangeFusion.VerticalAlignment   = -4108

# Lignes utilisateurs à partir de la ligne 5
$row = 5
$userIndex = 0
foreach ($user in $usersList) {
    # Colonne A : nom utilisateur
    $cellUser = $Sheet1.Cells.Item($row, 1)
    $cellUser.Value2 = $user
    $cellUser.Font.Bold = $false
    $cellUser.Font.Size = 10
    $cellUser.Interior.Color = $blanc

    # Bordure noire fine sur toute la ligne
    $rangeLigne = $Sheet1.Range($Sheet1.Cells.Item($row,1), $Sheet1.Cells.Item($row, $dfsFiltres.Count+1))
    $rangeLigne.Borders.LineStyle = 1
    $rangeLigne.Borders.Weight = 1
    $rangeLigne.Borders.Color = $noir

    $col = 2
    foreach ($dfs in $dfsFiltres) {
        $droitMax = ""
        foreach ($f in $relationsDFS[$dfs]) {
            if ($relationsFont[$f] -contains $user) {
                if ($dfs -like "*-RW") { $droitMax = "RW"; break }
                elseif ($dfs -like "*-R"  -and $droitMax -ne "RW") { $droitMax = "R" }
            }
        }
        if ($droitMax -ne "") {
            $cellM = $Sheet1.Cells.Item($row, $col)
            $cellM.Value2 = $droitMax
            $cellM.Font.Bold = $true
            $cellM.Font.Size = 10
            $cellM.Font.Color = $blanc
            $cellM.HorizontalAlignment = -4108
            $cellM.Interior.Color = if ($droitMax -eq "RW") { $couleurRW } else { $couleurR }
        }
        $col++
    }

    $row++
    $userIndex++
}

# Bordures sur les 4 lignes d'en-têtes
for ($niv = 1; $niv -le 4; $niv++) {
    $rangeNiv = $Sheet1.Range($Sheet1.Cells.Item($niv,1), $Sheet1.Cells.Item($niv, $dfsFiltres.Count+1))
    $rangeNiv.Borders.LineStyle = 1
    $rangeNiv.Borders.Weight = 1
    $rangeNiv.Borders.Color = $noir
}

# Hauteur des 4 lignes en-tête
for ($niv = 1; $niv -le 4; $niv++) {
    $Sheet1.Rows.Item($niv).RowHeight = 80
}

# AutoFit colonne A
$Sheet1.Columns.Item(1).AutoFit() | Out-Null

# Largeur minimale colonnes DFS
for ($c = 2; $c -le ($dfsFiltres.Count + 1); $c++) {
    $Sheet1.Columns.Item($c).ColumnWidth = 3.5
}

# Hauteur lignes utilisateurs
for ($r = 5; $r -le ($usersList.Count + 4); $r++) {
    $Sheet1.Rows.Item($r).RowHeight = 15
}

# Figer les 4 premières lignes et colonne A
$Sheet1.Activate()
$Excel.ActiveWindow.SplitRow = 4
$Excel.ActiveWindow.SplitColumn = 1
$Excel.ActiveWindow.FreezePanes = $true

# ============================================================
# FEUILLE 2 : Matrice DFS x Fonctionnels (inchangée)
# ============================================================
$Sheet2 = $Workbook.Sheets.Add()
$Sheet2.Name = "Matrice DFS Fonctionnels"

$couleursDFS = @(
    [long](183 * 65536 + 222 * 256 + 232),
    [long](216 * 65536 + 228 * 256 + 188),
    [long](252 * 65536 + 213 * 256 + 180),
    [long](230 * 65536 + 184 * 256 + 183),
    [long](204 * 65536 + 192 * 256 + 218)
)
$couleurRW2 = [long](64  * 65536 + 64  * 256 + 64)
$couleurR2  = [long](110 * 65536 + 110 * 256 + 110)
$grisClaire = [long](242 * 65536 + 242 * 256 + 242)

$Sheet2.Cells.Item(1,1).Value2 = "DFS \ Fonctionnels"
$Sheet2.Cells.Item(1,1).Font.Bold = $true
$Sheet2.Cells.Item(1,1).Font.Size = 10
$Sheet2.Cells.Item(1,1).Interior.Color = $grisEntete
$Sheet2.Cells.Item(1,1).Font.Color = $blanc

$col = 2
$colorIndex = 0
foreach ($f in $fonctionnels) {
    $cell = $Sheet2.Cells.Item(1, $col)
    $cell.Value2 = $f
    $cell.Font.Bold = $true
    $cell.Font.Size = 10
    $cell.Interior.Color = $couleursDFS[$colorIndex % $couleursDFS.Count]
    $cell.Orientation = 90
    $cell.HorizontalAlignment = -4108
    $cell.VerticalAlignment   = -4107
    $col++
    $colorIndex++
}

$row = 2
$dfsIndex = 0
foreach ($dfs in $GroupesDFS.Name) {
    $couleurLigne = if ($dfsIndex % 2 -eq 0) { $grisClaire } else { $blanc }

    $Sheet2.Cells.Item($row,1).Value2 = $dfs
    $Sheet2.Cells.Item($row,1).Font.Bold = $true
    $Sheet2.Cells.Item($row,1).Font.Size = 10
    $Sheet2.Cells.Item($row,1).Interior.Color = $couleurLigne

    $col = 2
    foreach ($f in $fonctionnels) {
        if ($relationsDFS[$dfs] -contains $f) {
            $cellM = $Sheet2.Cells.Item($row, $col)
            if ($dfs -like "*-RW") {
                $cellM.Value2 = "RW"
                $cellM.Interior.Color = $couleurRW2
            } elseif ($dfs -like "*-R") {
                $cellM.Value2 = "R"
                $cellM.Interior.Color = $couleurR2
            }
            $cellM.Font.Bold = $true
            $cellM.Font.Size = 10
            $cellM.Font.Color = $blanc
            $cellM.HorizontalAlignment = -4108
        }
        $col++
    }

    $rangeLigne = $Sheet2.Range($Sheet2.Cells.Item($row,1), $Sheet2.Cells.Item($row, $fonctionnels.Count+1))
    $rangeLigne.Borders.LineStyle = 1
    $rangeLigne.Borders.Weight = 1
    $rangeLigne.Borders.Color = $noir

    $row++
    $dfsIndex++
}

$Sheet2.Rows.Item(1).RowHeight = 120
$Sheet2.Columns.Item(1).AutoFit() | Out-Null
for ($c = 2; $c -le ($fonctionnels.Count + 1); $c++) {
    $Sheet2.Columns.Item($c).ColumnWidth = 3
}
for ($r = 2; $r -le ($GroupesDFS.Count + 1); $r++) {
    $Sheet2.Rows.Item($r).RowHeight = 15
}

$Sheet2.Activate()
$Excel.ActiveWindow.SplitRow = 1
$Excel.ActiveWindow.SplitColumn = 1
$Excel.ActiveWindow.FreezePanes = $true

# ============================================================
# SAUVEGARDE
# ============================================================
$chemin = "$env:USERPROFILE\Desktop\Matrice_Complete.xlsx"
$Workbook.SaveAs($chemin)
$Excel.Quit()

Write-Host "Fichier sauvegarde : $chemin" -ForegroundColor Green
