Le problème vient du fait que `System.Drawing` n'est pas chargé par défaut. On va charger l'assembly ET simplifier la gestion des couleurs en utilisant directement les valeurs RGB en BGR (format Excel COM).

```powershell
# ============================================================
# Script : Get-DFSRightsMatrix.ps1
# ============================================================

# Chargement de l'assembly System.Drawing
Add-Type -AssemblyName System.Drawing

# Fonction helper pour convertir RGB en couleur Excel COM
function Get-ExcelColor {
    param([int]$R, [int]$G, [int]$B)
    return $R + ($G * 256) + ($B * 65536)
}

# Couleurs définies
$ColorBlue      = Get-ExcelColor 31  73  125   # En-têtes
$ColorWhite     = Get-ExcelColor 255 255 255
$ColorGreen     = Get-ExcelColor 0   176 80    # RW
$ColorYellow    = Get-ExcelColor 255 192 0     # R
$ColorGrayLight = Get-ExcelColor 242 242 242   # Lignes paires
$ColorBlack     = Get-ExcelColor 0   0   0

# -------------------------------------------------------
# 1. Récupération des groupes DFS
# -------------------------------------------------------

Write-Host "`n[1/4] Récupération des groupes DFS..." -ForegroundColor Cyan

$DFSGroups = Get-ADGroup -Filter { Name -like "GG_BDX_BNU_CDAD*" } `
             -Properties Members, MemberOf | Sort-Object Name

Write-Host "      $($DFSGroups.Count) groupes DFS trouvés." -ForegroundColor Green

# -------------------------------------------------------
# 2. Récupération des groupes fonctionnels
# -------------------------------------------------------

Write-Host "[2/4] Récupération des groupes fonctionnels..." -ForegroundColor Cyan

$FuncGroups = Get-ADGroup -Filter { Name -like "GG_F_CDAD-BDX*" } `
              -Properties Members, MemberOf | Sort-Object Name

Write-Host "      $($FuncGroups.Count) groupes fonctionnels trouvés." -ForegroundColor Green

# -------------------------------------------------------
# 3. Construction de la matrice
# -------------------------------------------------------

Write-Host "[3/4] Construction de la matrice..." -ForegroundColor Cyan

$MatrixData = @()

foreach ($FuncGroup in $FuncGroups) {

    # Groupes DFS parents du groupe fonctionnel
    $ParentDFSGroups = Get-ADPrincipalGroupMembership -Identity $FuncGroup.DistinguishedName |
                       Where-Object { $_.Name -like "GG_BDX_BNU_CDAD*" }

    # Décomposition du nom pour les niveaux
    # Format : GG_F_CDAD-BDX_[N1]_[N2]_[N3]_[N4]
    $NameParts = ($FuncGroup.Name -replace "^GG_F_CDAD-BDX[-_]?", "") -split "_"

    $Row = [PSCustomObject]@{
        Groupe_Fonctionnel = $FuncGroup.Name
        Niveau_1           = if ($NameParts.Count -ge 1) { $NameParts[0] } else { "" }
        Niveau_2           = if ($NameParts.Count -ge 2) { $NameParts[1] } else { "" }
        Niveau_3           = if ($NameParts.Count -ge 3) { $NameParts[2] } else { "" }
        Niveau_4           = if ($NameParts.Count -ge 4) { $NameParts[3] } else { "" }
    }

    foreach ($DFSGroup in $DFSGroups) {
        $Match = $ParentDFSGroups | Where-Object { $_.Name -eq $DFSGroup.Name }
        $Right = if ($Match) {
            switch -Wildcard ($DFSGroup.Name) {
                "*-RW"  { "RW" }
                "*-R"   { "R"  }
                default { "?"  }
            }
        } else { "" }

        $Row | Add-Member -MemberType NoteProperty -Name $DFSGroup.Name -Value $Right
    }

    $MatrixData += $Row
    Write-Host "      Traitement : $($FuncGroup.Name)" -ForegroundColor Gray
}

Write-Host "      $($MatrixData.Count) lignes construites." -ForegroundColor Green

# -------------------------------------------------------
# 4. Export Excel via COM
# -------------------------------------------------------

Write-Host "[4/4] Génération Excel..." -ForegroundColor Cyan

$ExcelPath = "$PSScriptRoot\Matrice_Droits_DFS_$(Get-Date -Format 'yyyyMMdd_HHmmss').xlsx"

try {
    $Excel                = New-Object -ComObject Excel.Application
    $Excel.Visible        = $false
    $Excel.DisplayAlerts  = $false
    $Workbook             = $Excel.Workbooks.Add()

    # ===========================================================
    # FEUILLE 1 - Matrice
    # ===========================================================

    $Sheet1       = $Workbook.Worksheets.Item(1)
    $Sheet1.Name  = "Matrice Droits"

    $Headers = @("Groupe_Fonctionnel","Niveau_1","Niveau_2","Niveau_3","Niveau_4") +
               ($DFSGroups | Select-Object -ExpandProperty Name)

    # --- En-têtes ---
    for ($col = 0; $col -lt $Headers.Count; $col++) {
        $Cell                     = $Sheet1.Cells.Item(1, $col + 1)
        $Cell.Value2              = $Headers[$col]
        $Cell.Font.Bold           = $true
        $Cell.Font.Color          = $ColorWhite
        $Cell.Interior.Color      = $ColorBlue
        $Cell.HorizontalAlignment = -4108  # xlCenter

        # Rotation pour les colonnes DFS
        if ($col -ge 5) {
            $Cell.Orientation = 45
        }
    }

    # Hauteur de la ligne d'en-tête
    $Sheet1.Rows.Item(1).RowHeight = 100

    # --- Données ---
    $RowIndex = 2
    foreach ($Entry in $MatrixData) {

        $ColIndex = 1
        foreach ($Header in $Headers) {
            $Cell        = $Sheet1.Cells.Item($RowIndex, $ColIndex)
            $Val         = $Entry.$Header
            $Cell.Value2 = $Val
            $Cell.HorizontalAlignment = -4108

            switch ($Val) {
                "RW" {
                    $Cell.Interior.Color = $ColorGreen
                    $Cell.Font.Bold      = $true
                    $Cell.Font.Color     = $ColorWhite
                }
                "R" {
                    $Cell.Interior.Color = $ColorYellow
                    $Cell.Font.Bold      = $true
                    $Cell.Font.Color     = $ColorBlack
                }
                default {
                    if ($RowIndex % 2 -eq 0) {
                        $Cell.Interior.Color = $ColorGrayLight
                    }
                }
            }
            $ColIndex++
        }
        $RowIndex++
    }

    # --- Mise en forme ---
    $Sheet1.UsedRange.Borders.LineStyle = 1
    $Sheet1.UsedRange.Borders.Weight    = 2

    # Figer volets après ligne 1 et colonne 5
    $Sheet1.Cells.Item(2, 6).Select() | Out-Null
    $Excel.ActiveWindow.FreezePanes = $true

    # Ajustement colonnes fixes
    1..5 | ForEach-Object { $Sheet1.Columns.Item($_).AutoFit() | Out-Null }

    # Filtre auto
    $Sheet1.Rows.Item(1).AutoFilter() | Out-Null

    # ===========================================================
    # FEUILLE 2 - Détail Groupes DFS
    # ===========================================================

    $Sheet2      = $Workbook.Worksheets.Add()
    $Sheet2.Name = "Detail Groupes DFS"

    $DFSHeaders = @("Groupe_DFS", "Type_Droit", "Groupe_Fonctionnel_Membre")

    for ($col = 0; $col -lt $DFSHeaders.Count; $col++) {
        $Cell                = $Sheet2.Cells.Item(1, $col + 1)
        $Cell.Value2         = $DFSHeaders[$col]
        $Cell.Font.Bold      = $true
        $Cell.Interior.Color = $ColorBlue
        $Cell.Font.Color     = $ColorWhite
    }

    $Row2 = 2
    foreach ($DFSGroup in $DFSGroups) {

        $Right = switch -Wildcard ($DFSGroup.Name) {
            "*-RW"  { "Lecture / Ecriture" }
            "*-R"   { "Lecture seule"      }
            default { "Inconnu"            }
        }

        $BgColor = if ($Right -eq "Lecture / Ecriture") {
            Get-ExcelColor 198 239 206   # Vert clair
        } else {
            Get-ExcelColor 255 242 204   # Jaune clair
        }

        $Members = Get-ADGroupMember -Identity $DFSGroup.DistinguishedName |
                   Where-Object { $_.Name -like "GG_F_CDAD-BDX*" }

        if ($Members) {
            foreach ($Member in $Members) {
                $Sheet2.Cells.Item($Row2, 1).Value2 = $DFSGroup.Name
                $Sheet2.Cells.Item($Row2, 2).Value2 = $Right
                $Sheet2.Cells.Item($Row2, 3).Value2 = $Member.Name
                1..3 | ForEach-Object {
                    $Sheet2.Cells.Item($Row2, $_).Interior.Color = $BgColor
                }
                $Row2++
            }
        } else {
            $Sheet2.Cells.Item($Row2, 1).Value2 = $DFSGroup.Name
            $Sheet2.Cells.Item($Row2, 2).Value2 = $Right
            $Sheet2.Cells.Item($Row2, 3).Value2 = "(Aucun groupe fonctionnel)"
            $Row2++
        }
    }

    $Sheet2.UsedRange.Borders.LineStyle = 1
    $Sheet2.UsedRange.Columns.AutoFit() | Out-Null
    $Sheet2.Rows.Item(1).AutoFilter()   | Out-Null

    # ===========================================================
    # FEUILLE 3 - Légende
    # ===========================================================

    $Sheet3      = $Workbook.Worksheets.Add()
    $Sheet3.Name = "Legende"

    $Sheet3.Cells.Item(1,1).Value2    = "LEGENDE"
    $Sheet3.Cells.Item(1,1).Font.Bold = $true
    $Sheet3.Cells.Item(1,1).Font.Size = 14

    $Legends = @(
        @{ Row=3; Label="RW - Lecture / Ecriture"; Bg=$ColorGreen;     Fg=$ColorWhite }
        @{ Row=4; Label="R  - Lecture seule"      ; Bg=$ColorYellow;    Fg=$ColorBlack }
        @{ Row=5; Label="Vide - Aucun droit"       ; Bg=$ColorGrayLight; Fg=$ColorBlack }
    )

    foreach ($L in $Legends) {
        $Cell                = $Sheet3.Cells.Item($L.Row, 2)
        $Cell.Value2         = $L.Label
        $Cell.Interior.Color = $L.Bg
        $Cell.Font.Color     = $L.Fg
        $Cell.Font.Bold      = $true
        $Cell.ColumnWidth    = 30
    }

    # ===========================================================
    # Sauvegarde
    # ===========================================================

    $Sheet1.Activate()
    $Workbook.SaveAs($ExcelPath)
    $Workbook.Close($false)
    $Excel.Quit()

    Write-Host "`n✔ Fichier généré : $ExcelPath" -ForegroundColor Green

} catch {
    Write-Host "`n✘ Erreur : $_" -ForegroundColor Red

} finally {
    # Libération des objets COM
    @($Sheet3, $Sheet2, $Sheet1, $Workbook, $Excel) | ForEach-Object {
        if ($_) {
            [System.Runtime.Interopservices.Marshal]::ReleaseComObject($_) | Out-Null
        }
    }
    [GC]::Collect()
}
```

---

## Ce qui a changé

| Problème | Solution |
|----------|----------|
| `System.Drawing.ColorTranslator` introuvable | Remplacé par une fonction `Get-ExcelColor` qui calcule directement la valeur BGR attendue par Excel COM |
| `Add-Type -AssemblyName System.Drawing` | Ajouté en début de script au cas où |
| Gestion d'erreur | Ajout d'un bloc `try/catch/finally` pour éviter les processus Excel fantômes |

> 💡 La formule BGR Excel est : `R + (G × 256) + (B × 65536)`