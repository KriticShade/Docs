$ErrorActionPreference = "Stop"
$ExcelPath = "C:\Temp\Matrice_Droits_DFS.xlsx"
if (!(Test-Path "C:\Temp")) { New-Item -ItemType Directory -Path "C:\Temp" }

try {
    # Récupération des groupes
    $GroupesFonctionnels = Get-ADGroup -Filter {Name -like "GG_F_CDAD-BDX*"} | Select-Object -ExpandProperty Name | Sort-Object
    $GroupesDFS = Get-ADGroup -Filter {Name -like "GG_BDX_BNU_CDAD*"} | Select-Object -ExpandProperty Name | Sort-Object

    Write-Host "Groupes fonctionnels trouvés : $($GroupesFonctionnels.Count)"
    Write-Host "Groupes DFS trouvés : $($GroupesDFS.Count)"

    # Création Excel
    $Excel = New-Object -ComObject Excel.Application
    $Excel.Visible = $false
    $Excel.DisplayAlerts = $false
    $Workbook = $Excel.Workbooks.Add()
    $Sheet = $Workbook.Worksheets.Item(1)
    $Sheet.Name = "Matrice Droits"

    # Groupes fonctionnels EN HAUT (ligne 1, à partir de colonne B)
    for ($col = 0; $col -lt $GroupesFonctionnels.Count; $col++) {
        $cell = $Sheet.Cells.Item(1, $col + 2)
        $cell.Value2 = $GroupesFonctionnels[$col]
        $cell.Font.Bold = $true
        $cell.Interior.ColorIndex = 37
        $cell.Orientation = 90
        $cell.RowHeight = 120
    }

    # Groupes DFS À GAUCHE (colonne A, à partir de ligne 2)
    for ($row = 0; $row -lt $GroupesDFS.Count; $row++) {
        $cell = $Sheet.Cells.Item($row + 2, 1)
        $cell.Value2 = $GroupesDFS[$row]
        $cell.Font.Bold = $true
        $cell.Interior.ColorIndex = 40
    }

    # Remplissage de la matrice
    for ($row = 0; $row -lt $GroupesDFS.Count; $row++) {
        $groupeDFS = $GroupesDFS[$row]
        
        # Récupérer les membres du groupe DFS
        $membresDFS = Get-ADGroupMember -Identity $groupeDFS | Select-Object -ExpandProperty Name

        for ($col = 0; $col -lt $GroupesFonctionnels.Count; $col++) {
            $groupeF = $GroupesFonctionnels[$col]
            $cell = $Sheet.Cells.Item($row + 2, $col + 2)

            if ($membresDFS -contains $groupeF) {
                # Déterminer R ou W selon le suffixe du groupe DFS
                if ($groupeDFS -match "-RW$") {
                    $cell.Value2 = "W"
                    $cell.Interior.ColorIndex = 4  # Vert
                    $cell.Font.Bold = $true
                } elseif ($groupeDFS -match "-R$") {
                    $cell.Value2 = "R"
                    $cell.Interior.ColorIndex = 6  # Jaune
                    $cell.Font.Bold = $true
                }
            }
        }
    }

    # Mise en forme finale
    $Sheet.Columns.Item(1).ColumnWidth = 40
    $UsedRange = $Sheet.UsedRange
    $UsedRange.Borders.LineStyle = 1
    $UsedRange.HorizontalAlignment = -4108  # Centre

    # Sauvegarde
    $Workbook.SaveAs($ExcelPath)
    $Workbook.Close($false)
    $Excel.Quit()
    [System.Runtime.InteropServices.Marshal]::ReleaseComObject($Excel) | Out-Null

    Write-Host "`n✔ Fichier créé : $ExcelPath" -ForegroundColor Green

} catch {
    Write-Host "`n✘ ERREUR : " -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    Write-Host $_.ScriptStackTrace -ForegroundColor Yellow
    if ($Excel) { $Excel.Quit() }
}
