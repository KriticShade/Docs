$ExcelPath = "C:\Temp\Matrice_Droits_DFS.xlsx"

# Récupération des groupes
$GroupesFonctionnels = Get-ADGroup -Filter {Name -like "GG_F_CDAD-BDX*"} | Select-Object -ExpandProperty Name | Sort-Object
$GroupesDFS = Get-ADGroup -Filter {Name -like "GG_BDX_BNU_CDAD*"} | Select-Object -ExpandProperty Name | Sort-Object

Write-Host "Groupes Fonctionnels trouvés : $($GroupesFonctionnels.Count)"
Write-Host "Groupes DFS trouvés : $($GroupesDFS.Count)"

# Construction de la matrice
$Matrice = @{}

foreach ($DFS in $GroupesDFS) {
    $Matrice[$DFS] = @{}
    
    # Récupérer les membres du groupe DFS
    $Membres = Get-ADGroupMember -Identity $DFS | Select-Object -ExpandProperty Name
    
    foreach ($Fonctionnel in $GroupesFonctionnels) {
        if ($Membres -contains $Fonctionnel) {
            if ($DFS -like "*-RW") {
                $Matrice[$DFS][$Fonctionnel] = "W"
            } elseif ($DFS -like "*-R") {
                $Matrice[$DFS][$Fonctionnel] = "R"
            }
        } else {
            $Matrice[$DFS][$Fonctionnel] = ""
        }
    }
}

# Création Excel
$Excel = New-Object -ComObject Excel.Application
$Excel.Visible = $false
$Excel.DisplayAlerts = $false

$Workbook = $Excel.Workbooks.Add()
$Sheet = $Workbook.Worksheets.Item(1)
$Sheet.Name = "Matrice Droits"

# En-tête : Groupes Fonctionnels en ligne 1 à partir de colonne B
$Col = 2
foreach ($Fonctionnel in $GroupesFonctionnels) {
    $Cell = $Sheet.Cells.Item(1, $Col)
    $Cell.Value2 = $Fonctionnel
    $Cell.Font.Bold = $true
    $Cell.Interior.ColorIndex = 37
    $Cell.Font.ColorIndex = 2
    $Cell.Orientation = 90
    $Cell.RowHeight = 120
    $Col++
}

# Groupes DFS en colonne A à partir de ligne 2
$Row = 2
foreach ($DFS in $GroupesDFS) {
    $Cell = $Sheet.Cells.Item($Row, 1)
    $Cell.Value2 = $DFS
    $Cell.Font.Bold = $true
    
    # Couleur selon R ou RW
    if ($DFS -like "*-RW") {
        $Cell.Interior.ColorIndex = 44  # Orange
    } elseif ($DFS -like "*-R") {
        $Cell.Interior.ColorIndex = 43  # Vert
    }
    
    # Remplissage matrice
    $Col = 2
    foreach ($Fonctionnel in $GroupesFonctionnels) {
        $Valeur = $Matrice[$DFS][$Fonctionnel]
        $Cell = $Sheet.Cells.Item($Row, $Col)
        $Cell.Value2 = $Valeur
        $Cell.HorizontalAlignment = -4108  # Centré
        
        if ($Valeur -eq "W") {
            $Cell.Interior.ColorIndex = 44  # Orange
            $Cell.Font.Bold = $true
        } elseif ($Valeur -eq "R") {
            $Cell.Interior.ColorIndex = 43  # Vert
            $Cell.Font.Bold = $true
        }
        $Col++
    }
    $Row++
}

# Mise en forme
$Sheet.Columns.AutoFit() | Out-Null
$Sheet.Cells.Item(1,1).Value2 = "DFS \ Fonctionnel"
$Sheet.Cells.Item(1,1).Font.Bold = $true

# Figer la première ligne et colonne
$Sheet.Cells.Item(2,2).Select() | Out-Null
$Sheet.Application.ActiveWindow.FreezePanes = $true

# Sauvegarde
$Workbook.SaveAs($ExcelPath)
$Workbook.Close()
$Excel.Quit()

Write-Host "`n✔ Fichier créé : $ExcelPath" -ForegroundColor Green
