# Script PowerShell - Matrice des droits DFS complète

```powershell
# ============================================================
# Script : Get-DFSRightsMatrix.ps1
# Description : Génère une matrice Excel des droits DFS
# Prérequis   : Module ActiveDirectory uniquement
# ============================================================

# -------------------------------------------------------
# 1. Récupération des groupes DFS (GG_BDX_BNU_CDAD*)
# -------------------------------------------------------

Write-Host "`n[1/4] Récupération des groupes DFS..." -ForegroundColor Cyan

$DFSGroups = Get-ADGroup -Filter { Name -like "GG_BDX_BNU_CDAD*" } -Properties Members, MemberOf |
             Sort-Object Name

Write-Host "      $($DFSGroups.Count) groupes DFS trouvés." -ForegroundColor Green

# -------------------------------------------------------
# 2. Récupération des groupes fonctionnels (GG_F_CDAD-BDX*)
# -------------------------------------------------------

Write-Host "[2/4] Récupération des groupes fonctionnels..." -ForegroundColor Cyan

$FuncGroups = Get-ADGroup -Filter { Name -like "GG_F_CDAD-BDX*" } -Properties Members, MemberOf |
              Sort-Object Name

Write-Host "      $($FuncGroups.Count) groupes fonctionnels trouvés." -ForegroundColor Green

# -------------------------------------------------------
# 3. Construction de la matrice
# -------------------------------------------------------

Write-Host "[3/4] Construction de la matrice des droits..." -ForegroundColor Cyan

# Table de correspondance : Groupe Fonctionnel -> Groupes DFS avec droits
$MatrixData = @()

foreach ($FuncGroup in $FuncGroups) {

    # Récupère les groupes DFS parents du groupe fonctionnel
    $ParentDFSGroups = Get-ADPrincipalGroupMembership -Identity $FuncGroup.DistinguishedName |
                       Where-Object { $_.Name -like "GG_BDX_BNU_CDAD*" }

    # Décompose le nom du groupe fonctionnel pour extraire les niveaux
    # Format attendu : GG_F_CDAD-BDX_[NIVEAU1]_[NIVEAU2]_[NIVEAU3]...
    $NameParts  = $FuncGroup.Name -replace "^GG_F_CDAD-BDX_?", "" -split "_"

    $Row = [PSCustomObject]@{
        Groupe_Fonctionnel = $FuncGroup.Name
        Niveau_1           = if ($NameParts.Count -ge 1) { $NameParts[0] } else { "" }
        Niveau_2           = if ($NameParts.Count -ge 2) { $NameParts[1] } else { "" }
        Niveau_3           = if ($NameParts.Count -ge 3) { $NameParts[2] } else { "" }
        Niveau_4           = if ($NameParts.Count -ge 4) { $NameParts[3] } else { "" }
    }

    # Pour chaque groupe DFS, on ajoute une colonne dynamique avec le droit
    foreach ($DFSGroup in $DFSGroups) {
        $Match = $ParentDFSGroups | Where-Object { $_.Name -eq $DFSGroup.Name }

        $Right = if ($Match) {
            switch -Wildcard ($DFSGroup.Name) {
                "*-RW" { "RW" }
                "*-R"  { "R"  }
                default { "?"  }
            }
        } else { "" }

        $Row | Add-Member -MemberType NoteProperty -Name $DFSGroup.Name -Value $Right
    }

    $MatrixData += $Row
}

Write-Host "      Matrice construite : $($MatrixData.Count) lignes." -ForegroundColor Green

# -------------------------------------------------------
# 4. Export Excel via COM (sans module ImportExcel)
# -------------------------------------------------------

Write-Host "[4/4] Génération du fichier Excel..." -ForegroundColor Cyan

$ExcelPath = ".\Matrice_Droits_DFS_$(Get-Date -Format 'yyyyMMdd_HHmmss').xlsx"

# Création de l'objet Excel COM
$Excel       = New-Object -ComObject Excel.Application
$Excel.Visible = $false
$Excel.DisplayAlerts = $false

$Workbook  = $Excel.Workbooks.Add()

# -------------------------------------------------------
# FEUILLE 1 : Matrice complète
# -------------------------------------------------------

$Sheet1 = $Workbook.Worksheets.Item(1)
$Sheet1.Name = "Matrice Droits"

# --- En-têtes ---
$Headers = @("Groupe_Fonctionnel","Niveau_1","Niveau_2","Niveau_3","Niveau_4") + 
           ($DFSGroups | Select-Object -ExpandProperty Name)

for ($col = 0; $col -lt $Headers.Count; $col++) {
    $Cell = $Sheet1.Cells.Item(1, $col + 1)
    $Cell.Value2 = $Headers[$col]

    # Style en-tête
    $Cell.Font.Bold = $true
    $Cell.Font.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::White)
    $Cell.Interior.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::FromArgb(31,73,125))
    $Cell.HorizontalAlignment = -4108  # xlCenter

    # Rotation des en-têtes DFS pour lisibilité
    if ($col -ge 5) {
        $Cell.Orientation = 45
        $Cell.RowHeight   = 100
    }
}

# --- Données ---
$Row = 2
foreach ($Entry in $MatrixData) {

    $ColIndex = 1
    foreach ($Header in $Headers) {
        $Cell = $Sheet1.Cells.Item($Row, $ColIndex)
        $Val  = $Entry.$Header

        $Cell.Value2 = $Val

        # Colorisation selon le droit
        switch ($Val) {
            "RW" {
                $Cell.Interior.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::FromArgb(0,176,80))
                $Cell.Font.Bold      = $true
                $Cell.Font.Color     = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::White)
                $Cell.HorizontalAlignment = -4108
            }
            "R"  {
                $Cell.Interior.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::FromArgb(255,192,0))
                $Cell.Font.Bold      = $true
                $Cell.HorizontalAlignment = -4108
            }
            default {
                # Colorisation alternée des lignes
                if ($Row % 2 -eq 0) {
                    $Cell.Interior.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::FromArgb(242,242,242))
                }
            }
        }

        # Colorisation des colonnes Niveau_*
        if ($Header -like "Niveau_*" -and $Val -ne "") {
            $Cell.Font.Bold = $true
        }

        $ColIndex++
    }

    # Colorisation hiérarchique Niveau_1 (fond par groupe)
    $Lvl1Cell = $Sheet1.Cells.Item($Row, 2)
    $Lvl1Val  = $Entry.Niveau_1

    $ColorMap = @{
        # Adapter selon vos valeurs réelles de Niveau_1
        "COMPTA"   = [System.Drawing.Color]::FromArgb(189,215,238)
        "RH"       = [System.Drawing.Color]::FromArgb(226,239,218)
        "DIRECTION"= [System.Drawing.Color]::FromArgb(255,235,156)
        "TECHNIQUE" = [System.Drawing.Color]::FromArgb(255,204,153)
    }

    if ($ColorMap.ContainsKey($Lvl1Val)) {
        $Sheet1.Cells.Item($Row, 1).Interior.Color = `
            [System.Drawing.ColorTranslator]::ToOle($ColorMap[$Lvl1Val])
        $Sheet1.Cells.Item($Row, 2).Interior.Color = `
            [System.Drawing.ColorTranslator]::ToOle($ColorMap[$Lvl1Val])
    }

    $Row++
}

# --- Mise en forme finale ---
$UsedRange = $Sheet1.UsedRange
$UsedRange.Borders.LineStyle = 1
$UsedRange.Borders.Weight    = 2

# Figer les volets (ligne 1 + 5 premières colonnes)
$Sheet1.Cells.Item(2, 6).Select() | Out-Null
$Excel.ActiveWindow.FreezePanes = $true

# Ajustement automatique des colonnes 1 à 5
1..5 | ForEach-Object { $Sheet1.Columns.Item($_).AutoFit() | Out-Null }

# Filtre automatique
$Sheet1.Rows.Item(1).AutoFilter() | Out-Null

# -------------------------------------------------------
# FEUILLE 2 : Détail des membres par groupe DFS
# -------------------------------------------------------

$Sheet2 = $Workbook.Worksheets.Add()
$Sheet2.Name = "Détail Groupes DFS"

$DFSHeaders = @("Groupe_DFS","Type_Droit","Groupe_Fonctionnel_Membre")
for ($col = 0; $col -lt $DFSHeaders.Count; $col++) {
    $Cell = $Sheet2.Cells.Item(1, $col + 1)
    $Cell.Value2 = $DFSHeaders[$col]
    $Cell.Font.Bold = $true
    $Cell.Interior.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::FromArgb(31,73,125))
    $Cell.Font.Color = [System.Drawing.ColorTranslator]::ToOle([System.Drawing.Color]::White)
}

$Row2 = 2
foreach ($DFSGroup in $DFSGroups) {

    $Right = switch -Wildcard ($DFSGroup.Name) {
        "*-RW" { "Lecture/Ecriture" }
        "*-R"  { "Lecture seule"    }
        default { "Inconnu"         }
    }

    $Members = Get-ADGroupMember -Identity $DFSGroup.DistinguishedName |
               Where-Object { $_.Name -like "GG_F_CDAD-BDX*" }

    if ($Members) {
        foreach ($Member in $Members) {
            $Sheet2.Cells.Item($Row2, 1).Value2 = $DFSGroup.Name
            $Sheet2.Cells.Item($Row2, 2).Value2 = $Right
            $Sheet2.Cells.Item($Row2, 3).Value2 = $Member.Name

            $Color = if ($Right -eq "Lecture/Ecriture") {
                [System.Drawing.Color]::FromArgb(198,239,206)
            } else {
                [System.Drawing.Color]::FromArgb(255,242,204)
            }
            1..3 | ForEach-Object {
                $Sheet2.Cells.Item($Row2, $_).Interior.Color = `
                    [System.Drawing.ColorTranslator]::ToOle($Color)
            }
            $Row2++
        }
    } else {
        $Sheet2.Cells.Item($Row2, 1).Value2 = $DFSGroup.Name
        $Sheet2.Cells.Item($Row2, 2).Value2 = $Right
        $Sheet2.Cells.Item($Row2, 3).Value2 = "(Aucun groupe fonctionnel membre)"
        $Row2++
    }
}

$Sheet2.UsedRange.Borders.LineStyle = 1
$Sheet2.UsedRange.Columns.AutoFit() | Out-Null
$Sheet2.Rows.Item(1).AutoFilter() | Out-Null

# -------------------------------------------------------
# FEUILLE 3 : Légende
# -------------------------------------------------------

$Sheet3 = $Workbook.Worksheets.Add()
$Sheet3.Name = "Légende"

$Legends = @(
    @{ Label="RW - Lecture / Ecriture"; Color=[System.Drawing.Color]::FromArgb(0,176,80);   Font=[System.Drawing.Color]::White }
    @{ Label="R  - Lecture seule"     ; Color=[System.Drawing.Color]::FromArgb(255,192,0);  Font=[System.Drawing.Color]::Black }
    @{ Label="Vide - Aucun droit"     ; Color=[System.Drawing.Color]::FromArgb(242,242,242);Font=[System.Drawing.Color]::Black }
)

$Sheet3.Cells.Item(1,1).Value2 = "LÉGENDE"
$Sheet3.Cells.Item(1,1).Font.Bold = $true
$Sheet3.Cells.Item(1,1).Font.Size = 14

$LegRow = 3
foreach ($L in $Legends) {
    $Cell = $Sheet3.Cells.Item($LegRow, 2)
    $Cell.Value2 = $L.Label
    $Cell.Interior.Color = [System.Drawing.ColorTranslator]::ToOle($L.Color)
    $Cell.Font.Color     = [System.Drawing.ColorTranslator]::ToOle($L.Font)
    $Cell.Font.Bold      = $true
    $Cell.ColumnWidth    = 30
    $LegRow++
}

# -------------------------------------------------------
# Sauvegarde et fermeture
# -------------------------------------------------------

# Onglet 1 par défaut
$Sheet1.Activate()

$Workbook.SaveAs($ExcelPath)
$Workbook.Close($false)
$Excel.Quit()

# Libération COM
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Sheet3)  | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Sheet2)  | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Sheet1)  | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Workbook) | Out-Null
[System.Runtime.Interopservices.Marshal]::ReleaseComObject($Excel)    | Out-Null
[GC]::Collect()

Write-Host "`n✔ Fichier généré avec succès :" -ForegroundColor Green
Write-Host "  $((Resolve-Path $ExcelPath).Path)" -ForegroundColor White
```

---

## Structure du fichier Excel généré

| Feuille | Contenu |
|---------|---------|
| **Matrice Droits** | Tableau croisé Groupes Fonctionnels × Groupes DFS avec `R` / `RW` |
| **Détail Groupes DFS** | Quel groupe fonctionnel est membre de quel groupe DFS |
| **Légende** | Code couleur |

## Code couleur

| Couleur | Signification |
|---------|--------------|
| 🟢 Vert | `RW` - Lecture/Écriture |
| 🟡 Jaune | `R` - Lecture seule |
| ⬜ Gris | Aucun droit |
| 🔵 Bleu | En-têtes |

> ⚠️ **Pré-requis** : Microsoft Excel doit être installé sur la machine (utilisation du COM Object natif Windows - aucun module tiers)